<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(NgeoltxFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Renders the window without a display. Bindings, resource lookups and
         converters are resolved at runtime, not at compile time, so a window
         that builds can still fail to open. -->
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.2.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Ngeoltx.Engine/Ngeoltx.Engine.csproj" />
    <ProjectReference Include="../../src/Ngeoltx.Drivers/Ngeoltx.Drivers.csproj" />
    <ProjectReference Include="../../src/Ngeoltx.App/Ngeoltx.App.csproj" />
  </ItemGroup>
</Project>
