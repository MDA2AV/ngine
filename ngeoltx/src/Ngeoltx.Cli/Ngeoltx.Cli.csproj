<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(NgeoltxFramework)</TargetFramework>
    <!-- The desktop station owns the plain `ngeoltx` name; this is the
         headless companion used by CI and bench scripts. -->
    <AssemblyName>ngeoltx-cli</AssemblyName>
    <RootNamespace>Ngeoltx.Cli</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Ngeoltx.Engine/Ngeoltx.Engine.csproj" />
    <ProjectReference Include="../Ngeoltx.Drivers/Ngeoltx.Drivers.csproj" />
  </ItemGroup>
</Project>
